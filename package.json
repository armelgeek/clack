{
  "name": "clicknvape-backend",
  "version": "1.0.0",
  "description": "ClickNVape Backend",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
