    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/websockets": "^11.1.6",
    "@scalar/express-api-reference": "^0.8.22",
    "@thallesp/nestjs-better-auth": "^1.0.3",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "better-auth": "^1.2.7",
