# ========================================
# APPLICATION CONFIGURATION
# ========================================
NODE_ENV=development
PORT=3000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?search_path=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/clicknvape_db?search_path=public


# ========================================
# BETTER AUTH CONFIGURATION
# ========================================
# The public URL of your application (used by Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# Better Auth secret key
BETTER_AUTH_SECRET=your-better-auth-secret-here-min-32-chars

# ========================================
# GOOGLE OAUTH CONFIGURATION
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# FACEBOOK OAUTH CONFIGURATION
# ========================================

FACEBOOK_CLIENT_ID=your-facebook-client-id 
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ========================================
# TWITTER OAUTH CONFIGURATION
# ========================================
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# ========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ========================================
# SMTP host for sending emails
SMTP_HOST=smtp.gmail.com

# SMTP port (usually 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username/email
SMTP_USER=your-email@gmail.com

# SMTP password (or app-specific password for Gmail)
SMTP_PASS=your-app-specific-password

# ========================================
# FRONTEND URLs
# ========================================
# Superadmin/Management frontend URL
REACT_APP_URL_SUPERADMIN=https://staging.admin.clicknvape.fr

# Store admin frontend URL
REACT_APP_URL_ADMIN=https://staging.store.clicknvape.fr

# Client/Customer frontend URL
REACT_APP_URL_CLIENT=https://staging.client.clicknvape.fr

# ========================================
# STORAGE & CDN CONFIGURATION (OPTIONAL)
# ========================================
# AWS S3 or similar cloud storage configuration
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=your-bucket-name

# ========================================
# LOGGING (OPTIONAL)
# ========================================
# Log level: debug, info, warn, error
LOG_LEVEL=debug
